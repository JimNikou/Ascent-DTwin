{
  "title": "Ascent-DTwin — Live Telemetry",
  "uid": "ascent-dtwin",
  "timezone": "browser",
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "bucket",
        "label": "InfluxDB bucket",
        "type": "constant",
        "query": "ascent-twins",
        "current": {"text": "ascent-twins", "value": "ascent-twins"},
        "hide": 0
      },
      {
        "name": "twin",
        "label": "Twin",
        "type": "query",
        "datasource": {"type": "influxdb", "uid": null},
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"twin_id\")",
        "refresh": 1,
        "current": {"text": "esp32-demo", "value": "esp32-demo"},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Temperature (°C) — ${twin}",
      "type": "timeseries",
      "datasource": {"type": "influxdb", "uid": null},
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\") |> range(start: -1h) |> filter(fn: (r) => r[\"_measurement\"] == \"telemetry\" and r[\"twin_id\"] == \"${twin}\" and r[\"_field\"] == \"temperature\") |> aggregateWindow(every: 5s, fn: mean, createEmpty: false)"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "Humidity (%) — ${twin}",
      "type": "timeseries",
      "datasource": {"type": "influxdb", "uid": null},
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\") |> range(start: -1h) |> filter(fn: (r) => r[\"_measurement\"] == \"telemetry\" and r[\"twin_id\"] == \"${twin}\" and r[\"_field\"] == \"humidity\") |> aggregateWindow(every: 5s, fn: mean, createEmpty: false)"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "title": "CO2 + Pressure — ${twin}",
      "type": "timeseries",
      "datasource": {"type": "influxdb", "uid": null},
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"${bucket}\") |> range(start: -1h) |> filter(fn: (r) => r[\"_measurement\"] == \"telemetry\" and r[\"twin_id\"] == \"${twin}\" and (r[\"_field\"] == \"co2\" or r[\"_field\"] == \"pressure\"))"
        }
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
    }
  ],
  "schemaVersion": 39,
  "version": 2
}